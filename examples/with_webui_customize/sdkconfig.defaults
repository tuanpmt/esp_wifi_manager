CONFIG_IDF_TARGET="esp32s3"

# Enable WiFi Manager Web UI with custom path
CONFIG_WIFI_MGR_ENABLE_WEBUI=y
CONFIG_WIFI_MGR_WEBUI_CUSTOM_PATH="/littlefs"

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Captive portal: modern Android/Chrome probes send long headers (default 512 -> HTTP 431)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# 1.5 MB app + 512 KB LittleFS needs more than the 2 MB default flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
